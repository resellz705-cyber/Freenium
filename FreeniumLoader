--============================== FALLBACK UI ==============================
-- Used when CONFIG.Screen is off, or when no GUI parent will accept us.
local function notifyShim()
	local ui = { mounted = false }
	local function toast(text, dur)
		pcall(function()
			StarterGui:SetCore("SendNotification", { Title = CONFIG.Brand, Text = text, Duration = dur or 3 })
		end)
	end
	function ui.start(i) toast(STEPS[i] .. "…") end
	function ui.finish() end
	function ui.detail() end
	function ui.progress() end
	function ui.subtitle() end
	function ui.fail(text) toast(text, 8) end
	function ui.close() end
	return ui
end

--============================== BOOT SCREEN ==============================
-- gethui() is the cleanest parent but some executors can't write to it
-- (Potassium throws "lacking capability"), so fall through to CoreGui and
-- then PlayerGui and check the parent actually stuck each time.
local function mount(gui)
	local targets = {}
	if typeof(gethui) == "function" then
		local ok, hidden = pcall(gethui)
		if ok and hidden then targets[#targets + 1] = hidden end
	end
	local ok, core = pcall(game.GetService, game, "CoreGui")
	if ok and core then targets[#targets + 1] = core end
	targets[#targets + 1] = LocalPlayer:FindFirstChildOfClass("PlayerGui")

	for _, parent in ipairs(targets) do
		if parent then
			pcall(function()
				if typeof(syn) == "table" and syn.protect_gui then syn.protect_gui(gui) end
				if typeof(protectgui) == "function" then protectgui(gui) end
			end)
			local set = pcall(function() gui.Parent = parent end)
			if set and gui.Parent == parent then return true end
		end
	end
	return false
end

local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props) do inst[k] = v end
	for _, child in ipairs(children or {}) do child.Parent = inst end
	return inst
end

local function corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r) })
end

local DIM   = Color3.fromRGB(104, 104, 114)
local MUTED = Color3.fromRGB(150, 150, 160)
local LIT   = Color3.fromRGB(238, 238, 243)

local function buildScreen()
	local ROW_H, ROW_Y = 27, 102
	local height = ROW_Y + #STEPS * ROW_H + 70

	-- a second copy of the loader shouldn't stack two boot screens
	for _, parent in ipairs({ LocalPlayer:FindFirstChildOfClass("PlayerGui"), game:FindFirstChild("CoreGui") }) do
		if parent then
			local old = parent:FindFirstChild("FreeniumBoot")
			if old then pcall(function() old:Destroy() end) end
		end
	end

	local screen = new("ScreenGui", {
		Name = "FreeniumBoot",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 2147483647,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})

	local backdrop = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	backdrop.Parent = screen

	local holder = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(430, height),
		BackgroundTransparency = 1,
	})
	holder.Parent = backdrop

	-- soft drop shadow behind the card; if the asset fails it's invisible
	local shadow = new("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 70, 1, 70),
		BackgroundTransparency = 1,
		Image = "rbxassetid://6014261993",
		ImageColor3 = Color3.new(0, 0, 0),
		ImageTransparency = 1,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(49, 49, 450, 450),
	})
	shadow.Parent = holder

	local card = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(13, 13, 15),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, {
		corner(14),
		new("UIStroke", {
			Color = Color3.fromRGB(42, 42, 48),
			Thickness = 1,
			Transparency = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
	})
	card.Parent = holder

	local stroke = card:FindFirstChildOfClass("UIStroke")
	local fading = {}   -- everything that fades in, with its lit transparency

	local function track(inst, prop)
		fading[#fading + 1] = { inst = inst, prop = prop }
		return inst
	end

	local avatar = new("ImageLabel", {
		Position = UDim2.fromOffset(22, 22),
		Size = UDim2.fromOffset(42, 42),
		BackgroundColor3 = Color3.fromRGB(26, 26, 30),
		BackgroundTransparency = 1,
		ImageTransparency = 1,
		BorderSizePixel = 0,
		Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(LocalPlayer.UserId) .. "&w=150&h=150",
	}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	avatar.Parent = card
	track(avatar, "ImageTransparency")
	track(avatar, "BackgroundTransparency")

	local title = new("TextLabel", {
		Position = UDim2.fromOffset(76, 23),
		Size = UDim2.new(1, -170, 0, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = CONFIG.Brand,
		TextColor3 = Color3.fromRGB(245, 245, 248),
		TextSize = 19,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	title.Parent = card
	track(title, "TextTransparency")

	local subtitle = new("TextLabel", {
		Position = UDim2.fromOffset(76, 45),
		Size = UDim2.new(1, -170, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = CONFIG.Tagline,
		TextColor3 = DIM,
		TextSize = 12,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	subtitle.Parent = card
	track(subtitle, "TextTransparency")

	local percent = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -22, 0, 28),
		Size = UDim2.fromOffset(80, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "0%",
		TextColor3 = Color3.fromRGB(88, 88, 98),
		TextSize = 20,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	percent.Parent = card
	track(percent, "TextTransparency")

	local divider = new("Frame", {
		Position = UDim2.fromOffset(22, 84),
		Size = UDim2.new(1, -44, 0, 1),
		BackgroundColor3 = Color3.fromRGB(34, 34, 40),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	divider.Parent = card
	track(divider, "BackgroundTransparency")

	-- checklist rows
	local rows = {}
	for i, label in ipairs(STEPS) do
		local y = ROW_Y + (i - 1) * ROW_H

		local mark = new("TextLabel", {
			Position = UDim2.fromOffset(24, y),
			Size = UDim2.fromOffset(16, 18),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = "\u{2022}",
			TextColor3 = Color3.fromRGB(58, 58, 66),
			TextSize = 14,
			TextTransparency = 1,
		})
		mark.Parent = card
		track(mark, "TextTransparency")

		local text = new("TextLabel", {
			Position = UDim2.fromOffset(46, y),
			Size = UDim2.new(1, -210, 0, 18),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			Text = label,
			TextColor3 = DIM,
			TextSize = 13,
			TextTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		text.Parent = card
		track(text, "TextTransparency")

		local detail = new("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -22, 0, y),
			Size = UDim2.fromOffset(160, 18),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = "",
			TextColor3 = MUTED,
			TextSize = 12,
			TextTransparency = 0,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Right,
		})
		detail.Parent = card

		rows[i] = { mark = mark, text = text, detail = detail, state = "pending" }
	end

	local barY = ROW_Y + #STEPS * ROW_H + 12

	local bar = new("Frame", {
		Position = UDim2.fromOffset(22, barY),
		Size = UDim2.new(1, -44, 0, 4),
		BackgroundColor3 = Color3.fromRGB(30, 30, 35),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, { corner(2) })
	bar.Parent = card
	track(bar, "BackgroundTransparency")

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = CONFIG.Accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, { corner(2) })
	fill.Parent = bar
	track(fill, "BackgroundTransparency")

	-- shimmer. Lives on the fill Frame, never on a TextLabel - a UIGradient
	-- paints a label's text as well as its background and the text vanishes.
	local shimmer = new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.0, Color3.fromRGB(140, 140, 150)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(1.0, Color3.fromRGB(140, 140, 150)),
		}),
	})
	shimmer.Parent = fill

	local footer = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.new(1, -44, 0, 15),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = CONFIG.Footer,
		TextColor3 = Color3.fromRGB(84, 84, 94),
		TextSize = 11,
		TextTransparency = 1,
	})
	footer.Parent = card
	track(footer, "TextTransparency")

	if not mount(screen) then
		pcall(function() screen:Destroy() end)
		return nil
	end

	local blur
	if CONFIG.Blur then
		blur = new("BlurEffect", { Name = "FreeniumBlur", Size = 0 })
		pcall(function() blur.Parent = Lighting end)
	end

	--------------------------------------------------------------------
	local ui = { mounted = true }
	local alive = true
	local target, shown = 0, 0
	local active = 0

	local QUICK = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local function tween(inst, props, info)
		local ok, t = pcall(TweenService.Create, TweenService, inst, info or QUICK, props)
		if ok then t:Play() end
	end

	-- intro
	tween(backdrop, { BackgroundTransparency = 0.4 }, TweenInfo.new(0.4))
	tween(holder, { Position = UDim2.fromScale(0.5, 0.5) },
		TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
	tween(card, { BackgroundTransparency = 0 }, TweenInfo.new(0.4))
	tween(shadow, { ImageTransparency = 0.45 }, TweenInfo.new(0.4))
	tween(stroke, { Transparency = 0 }, TweenInfo.new(0.4))
	for _, f in ipairs(fading) do
		tween(f.inst, { [f.prop] = 0 }, TweenInfo.new(0.4))
	end
	if blur then tween(blur, { Size = 16 }, TweenInfo.new(0.5)) end

	-- one animator thread: everything else just sets state, so the bar keeps
	-- moving and the active row keeps pulsing while the main thread is stuck
	-- inside HttpGet waiting on a multi-megabyte download
	task.spawn(function()
		local offset, clock = 0, 0
		while alive do
			shown += (target - shown) * 0.12
			local clamped = math.clamp(shown, 0, 1)
			fill.Size = UDim2.new(clamped, 0, 1, 0)
			percent.Text = tostring(math.floor(clamped * 100 + 0.5)) .. "%"

			offset = (offset + 0.03) % 2
			shimmer.Offset = Vector2.new(offset - 1, 0)

			clock += 1 / 60
			local row = rows[active]
			if row and row.state == "active" then
				row.mark.TextTransparency = 0.2 + 0.5 * (0.5 + 0.5 * math.sin(clock * 6))
			end
			task.wait()
		end
	end)

	function ui.progress(p) target = math.clamp(p, 0, 1) end
	function ui.subtitle(text) subtitle.Text = text end

	function ui.start(i)
		local row = rows[i]
		if not row then return end
		active = i
		row.state = "active"
		row.mark.TextColor3 = CONFIG.Accent
		tween(row.text, { TextColor3 = LIT })
		target = math.max(target, (i - 1) / #STEPS)
	end

	function ui.finish(i, detail)
		local row = rows[i]
		if not row then return end
		row.state = "done"
		row.mark.Text = "\u{2713}"
		row.mark.TextColor3 = CONFIG.Accent
		row.mark.TextTransparency = 0
		tween(row.text, { TextColor3 = MUTED })
		if detail then
			row.detail.Text = detail
			row.detail.TextTransparency = 1
			tween(row.detail, { TextTransparency = 0 })
		end
		target = math.max(target, i / #STEPS)
	end

	function ui.detail(i, text)
		local row = rows[i]
		if row then row.detail.Text = text end
	end

	function ui.fail(text)
		local row = rows[active]
		if row then
			row.state = "failed"
			row.mark.Text = "\u{2715}"
			row.mark.TextColor3 = CONFIG.Bad
			row.mark.TextTransparency = 0
			row.text.TextColor3 = CONFIG.Bad
			row.detail.Size = UDim2.fromOffset(250, 18)
			row.detail.TextColor3 = CONFIG.Bad
			row.detail.Text = text
		end
		percent.TextColor3 = CONFIG.Bad
		fill.BackgroundColor3 = CONFIG.Bad
		shimmer.Enabled = false
		task.delay(8, ui.close)
	end

	function ui.close()
		if not alive then return end
		alive = false
		tween(holder, { Position = UDim2.fromScale(0.5, 0.48) }, TweenInfo.new(0.3))
		tween(backdrop, { BackgroundTransparency = 1 }, TweenInfo.new(0.3))
		tween(stroke, { Transparency = 1 }, TweenInfo.new(0.25))
		tween(card, { BackgroundTransparency = 1 }, TweenInfo.new(0.25))
		tween(shadow, { ImageTransparency = 1 }, TweenInfo.new(0.25))
		for _, f in ipairs(fading) do
			tween(f.inst, { [f.prop] = 1 }, TweenInfo.new(0.25))
		end
		for _, row in ipairs(rows) do
			tween(row.detail, { TextTransparency = 1 }, TweenInfo.new(0.25))
		end
		if blur then
			tween(blur, { Size = 0 }, TweenInfo.new(0.3))
			task.delay(0.4, function() pcall(function() blur:Destroy() end) end)
		end
		task.delay(0.5, function() pcall(function() screen:Destroy() end) end)
	end

	return ui
end

--============================== FETCH ==============================
-- raw.githubusercontent caches for ~5 minutes and executors cache HttpGet on
-- top of that, so a fresh upload can serve stale for a while.  A throwaway
-- query param changes the cache key and gets the new copy immediately.
local function fetch(url)
	local last
	for attempt = 1, CONFIG.Retries do
		local bust = (url:find("?", 1, true) and "&" or "?") .. "_=" .. tostring(os.time()) .. tostring(math.random(1e6))
		local ok, body = pcall(function() return game:HttpGet(url .. bust, true) end)
		if ok and type(body) == "string" and #body > 32
			and not body:find("404: Not Found", 1, true)
			and not body:find("<!DOCTYPE html", 1, true) then
			return body
		end
		last = ok and "empty or 404 response" or tostring(body)
		if attempt < CONFIG.Retries then task.wait(0.5 * attempt) end
	end
	return nil, last
end

--============================== BOOT ==============================
-- re-running the loader shouldn't stack two copies of the same hub
if getgenv then
	if getgenv().__FreeniumLoaderBusy then
		return warn("[Freenium] already loading - give it a second.")
	end
	getgenv().__FreeniumLoaderBusy = true
	task.delay(30, function() getgenv().__FreeniumLoaderBusy = nil end)
end

local ui = (CONFIG.Screen and buildScreen()) or notifyShim()
local started = os.clock()

local function abort(text, detail)
	ui.fail(text)
	warn("[Freenium] " .. text .. (detail and ("  |  " .. tostring(detail)) or ""))
	if getgenv then getgenv().__FreeniumLoaderBusy = nil end
end

-- 1. executor
ui.start(1)
ui.subtitle(LocalPlayer.DisplayName)
task.wait(0.3)

local exec = "Unknown"
if typeof(identifyexecutor) == "function" then
	local ok, name = pcall(identifyexecutor)
	if ok and type(name) == "string" and #name > 0 then exec = name end
end

-- indexing HttpGet can itself throw on a locked-down executor, hence the pcall
local okHttp, httpGet = pcall(function() return game.HttpGet end)
if typeof(loadstring) ~= "function" or not okHttp or typeof(httpGet) ~= "function" then
	return abort("no loadstring / HttpGet")
end
ui.finish(1, exec)

-- 2. game
ui.start(2)
if not game:IsLoaded() then game.Loaded:Wait() end
task.wait(0.3)
ui.finish(2, "ready")

-- 3. detection
ui.start(3)
task.wait(0.3)

local entry = UNIVERSES[game.GameId] or GAMES[game.PlaceId]
if not entry then
	if setclipboard then pcall(setclipboard, tostring(game.PlaceId)) end
	local supported = {}
	for _, g in pairs(UNIVERSES) do supported[#supported + 1] = g.name end
	for _, g in pairs(GAMES) do supported[#supported + 1] = g.name end
	table.sort(supported)
	return abort("game not supported yet",
		"place " .. game.PlaceId .. " / universe " .. game.GameId
		.. "  |  supported: " .. table.concat(supported, ", "))
end
ui.finish(3, entry.name)

-- 4. download. The real work, and the slow part on a big obfuscated file.
-- HttpGet gives no byte-level progress, so the bar eases toward the end of
-- this step's slot and the row counts real seconds instead of faking MB.
ui.start(4)
local body, err, done
task.spawn(function()
	body, err = fetch(entry.url or (CONFIG.Base .. entry.file))
	done = true
end)

local slot, span = 3 / #STEPS, 1 / #STEPS
local t0 = os.clock()
while not done do
	local elapsed = os.clock() - t0
	ui.progress(slot + span * (1 - math.exp(-elapsed / 4)))
	ui.detail(4, string.format("%.1fs", elapsed))
	task.wait(0.05)
end

if not body then
	return abort("download failed - check connection", err)
end
ui.finish(4, string.format("%.1f MB", #body / 1048576))

-- 5. compile, separately from running, so a bad upload reads as a compile
-- error instead of a mystery runtime failure inside the loader
ui.start(5)
task.wait(0.25)
local fn, compileErr = loadstring(body, "=" .. entry.name)
if not fn then
	return abort("build failed to compile", compileErr)
end
ui.finish(5, "ok")

ui.start(6)
ui.progress(1)

-- don't let a fast load flash the screen for a quarter second
local held = os.clock() - started
if held < CONFIG.MinTime then task.wait(CONFIG.MinTime - held) end
ui.finish(6, entry.name)
task.wait(0.4)

ui.close()
task.wait(0.4)

local ok, runErr = pcall(fn)
if not ok then
	warn("[Freenium] runtime error in " .. entry.name .. ": " .. tostring(runErr))
end
