--[[
	FREENIUM LOADER - one loadstring, every game

	This is the ONLY thing your users ever copy:

		loadstring(game:HttpGet("https://raw.githubusercontent.com/resellz705-cyber/Freenium/main/FreeniumLoader"))()

	Nothing needs to exist on their PC. It downloads the matching script
	straight from the repo into memory and runs it there. Re-upload an
	obfuscated script whenever you like - nobody has to re-copy anything.

	If you ever add a key system, the key goes above it and stays global for
	whatever script this loader pulls in:
		script_key = "..."
		loadstring(game:HttpGet(".../FreeniumLoader"))()
]]

local CONFIG = {
	Brand    = "FREENIUM",
	Tagline  = "script loader",
	Footer   = "discord.gg/solohub",
	Base     = "https://raw.githubusercontent.com/resellz705-cyber/Freenium/main/",
	Retries  = 3,
	MinTime  = 2.4,    -- hold the screen at least this long so it doesn't flash
	Screen   = true,   -- false = no GUI at all, plain Roblox notifications
	Blur     = true,   -- blur the game behind the card
	Accent   = Color3.fromRGB(255, 255, 255),
	Bad      = Color3.fromRGB(235, 80, 80),
}

-- The checklist, in order. Each one ticks off with a real detail beside it.
local STEPS = {
	"Checking executor",
	"Loading workspace",
	"Detecting game",
	"Downloading script",
	"Verifying build",
	"Launching",
}

-- GameId (universe) -> script.  One experience can own many places - lobbies,
-- private servers, sequels - so mapping the universe catches all of them at
-- once.  Resolve a new one with:
--   https://apis.roblox.com/universes/v1/places/<placeId>/universe
local UNIVERSES = {
	[10764627709] = { name = "Huss Valley", file = "HussValley_dist-obfuscated.lua" },
	[6035872082]  = { name = "RIVALS",      file = "SoloRivals-obfuscated.lua" },
	-- the space in the uploaded filename has to be %20 in the URL
	[6331902150]  = { name = "Forsaken",    file = "Solo%20Hub%20forsaken-obfuscated.lua" },
}

-- PlaceId -> script.  Only checked if the universe missed; use this when you
-- want one specific place to get a different script than the rest.
local GAMES = {
	-- [0] = { name = "Something", file = "Something-obfuscated.lua" },
}

--============================== SERVICES ==============================
local Players      = game:GetService("Players")
local TweenService = game:GetService("TweenService")
